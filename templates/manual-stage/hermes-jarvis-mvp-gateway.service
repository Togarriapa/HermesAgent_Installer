[Unit]
Description=Jarvis single-application Access gateway stage
Requires=hermes-jarvis-mvp-stage-bootstrap.service hermes-jarvis-mvp-inspector.service hermes-xpra-stage.service
After=hermes-jarvis-mvp-stage-bootstrap.service hermes-jarvis-mvp-inspector.service hermes-xpra-stage.service

[Service]
Type=simple
User=996
Group=981
UMask=0077
Environment=PYTHONPATH=/opt/hermes-jarvis-mvp-20261011/gateway-source/src
Environment=PYTHONNOUSERSITE=1
Environment=PYTHONDONTWRITEBYTECODE=1
UnsetEnvironment=PYTHONHOME PYTHONUSERBASE PYTHONSTARTUP
ExecStart=/opt/hermes-jarvis-mvp-20261011/gateway-venv/bin/python -m hermes_installer.remote.manual_stage
Restart=on-failure
RestartSec=2
TimeoutStartSec=15
RuntimeDirectory=hermes-jarvis-mvp-gateway
RuntimeDirectoryMode=0750
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
