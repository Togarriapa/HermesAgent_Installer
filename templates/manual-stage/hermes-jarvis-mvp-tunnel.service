[Unit]
Description=Cloudflare Tunnel for the Jarvis single-application MVP
Wants=network-online.target
Requires=hermes-jarvis-mvp-gateway.service
After=network-online.target hermes-jarvis-mvp-gateway.service
RequiresMountsFor=/etc/hermes-installer/jarvis-tunnel-token

[Service]
Type=simple
DynamicUser=yes
SupplementaryGroups=981
UMask=0077
LoadCredential=tunnel-token:/etc/hermes-installer/jarvis-tunnel-token
ExecStart=/usr/bin/cloudflared --no-autoupdate tunnel run --token-file %d/tunnel-token
Restart=on-failure
RestartSec=3
TimeoutStartSec=30
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
