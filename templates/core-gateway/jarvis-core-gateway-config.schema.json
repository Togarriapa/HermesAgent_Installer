{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Jarvis core gateway root-owned configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "hostname", "issuer", "audience", "allowed_emails",
    "gateway_uid", "gateway_gid", "core_uid", "core_gid", "boot_id",
    "gateway_unit_sha256", "gateway_python_sha256", "tunnel_unit_sha256",
    "cloudflared_binary_sha256", "core_unit_sha256", "core_launcher_sha256",
    "core_python", "core_python_sha256", "ingress_socket"
  ],
  "properties": {
    "schema": {"const": 1},
    "hostname": {"type": "string", "pattern": "^[A-Za-z0-9.-]{1,253}$"},
    "issuer": {"type": "string", "format": "uri"},
    "audience": {"type": "string", "minLength": 1},
    "allowed_emails": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "string", "format": "email"}},
    "gateway_uid": {"const": 996},
    "gateway_gid": {"const": 981},
    "core_uid": {"const": 1000},
    "core_gid": {"const": 1000},
    "boot_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "gateway_unit_sha256": {"$ref": "#/$defs/sha256"},
    "gateway_python_sha256": {"$ref": "#/$defs/sha256"},
    "tunnel_unit_sha256": {"$ref": "#/$defs/sha256"},
    "cloudflared_binary_sha256": {"$ref": "#/$defs/sha256"},
    "core_unit_sha256": {"$ref": "#/$defs/sha256"},
    "core_launcher_sha256": {"$ref": "#/$defs/sha256"},
    "core_python": {"type": "string", "pattern": "^/home/admin/HermesInstaller/data/installs/[0-9a-f]{24}/environments/[0-9a-f]{32}/venv/bin/python$"},
    "core_python_sha256": {"$ref": "#/$defs/sha256"},
    "ingress_socket": {"const": "/run/hermes-jarvis-mvp-gateway/origin.sock"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
