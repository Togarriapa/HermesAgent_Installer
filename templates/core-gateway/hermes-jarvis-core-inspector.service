[Unit]
Description=Read-only root currentness witness for core Jarvis ingress
Requires=hermes-jarvis-core.service
After=hermes-jarvis-core.service
Before=hermes-jarvis-core-gateway.service

[Service]
Type=simple
User=root
Group=981
UMask=0077
Environment=PYTHONPATH=/opt/hermes-jarvis-mvp-20261011/gateway-source/src
Environment=PYTHONNOUSERSITE=1
Environment=PYTHONDONTWRITEBYTECODE=1
UnsetEnvironment=PYTHONHOME PYTHONUSERBASE PYTHONSTARTUP
ExecStart=/opt/hermes-jarvis-mvp-20261011/gateway-venv/bin/python -m hermes_installer.remote.core_gateway_inspector
Restart=on-failure
RestartSec=2
TimeoutStartSec=10
RuntimeDirectory=hermes-jarvis-mvp-core
RuntimeDirectoryMode=0750
ExecStartPre=/usr/bin/install -d -o root -g 1000 -m 0750 /run/hermes-jarvis-native-observer
ReadWritePaths=/var/lib/hermes-installer/core-runtime
SupplementaryGroups=1000
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_NETLINK
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
