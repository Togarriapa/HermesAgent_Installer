{
  "name": "hermes-agent-installer",
  "version": "0.0.0",
  "description": "OpenSpec-driven Raspberry Pi Hermes installer; immutable specification baseline",
  "scripts": {
    "validate:specs": "openspec validate --all --strict --no-interactive --json",
    "validate:plan": "python3 scripts/check_plan.py --live && python3 scripts/check_plan.py",
    "test:planning": "python3 -m unittest discover -s tests/planning -v"
  },
